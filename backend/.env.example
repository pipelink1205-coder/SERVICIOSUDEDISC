# Copia este archivo como .env y ajusta lo que necesites.
EPI_PUERTO=8020
# Archivo o carpeta con los libros mensuales (para «Leer desde carpeta»)
EPI_CARPETA_DATOS=C:\ruta\a\Reportes
# Usuario administrador que se crea la primera vez (cámbiale la clave al entrar)
EPI_ADMIN_USUARIO=admin
EPI_ADMIN_CLAVE=Discapacidad2026*
# Opcional: ruta del libro semilla para la prueba de aceptación
EPI_LIBRO_SEMILLA=
